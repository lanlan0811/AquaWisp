{
  "schemaVersion": 1,
  "initialUrl": "about:blank",
  "allowedProtocols": ["http:", "https:"],
  "debuggerProtocolVersion": "1.3",
  "automation": {
    "interactiveSelector": "a[href],button,input,textarea,select,[role],[contenteditable=true],[tabindex]",
    "referenceAttribute": "data-aquawisp-ref",
    "referencePrefix": "aqw",
    "maximumSnapshotElements": 500,
    "maximumNodeTextCharacters": 512,
    "maximumArtifactBase64Characters": 33554432,
    "waitPollIntervalMs": 100,
    "screenshotFormat": "png"
  }
}
