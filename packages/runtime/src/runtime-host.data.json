{
  "schemaVersion": 1,
  "databaseFileName": "events.sqlite",
  "maximumCycles": 16,
  "streamRecovery": {
    "maximumAttempts": 1
  },
  "knowledge": {
    "databaseFileName": "kb.sqlite",
    "listLimit": 500
  },
  "tools": {
    "workspaceDirectoryName": "workspace",
    "maximumToolArgumentsBytes": 262144,
    "maximumObservationBytes": 262144,
    "filesystemMaximumFileBytes": 262144,
    "searchMaximumResults": 500,
    "searchMaximumFileBytes": 4194304,
    "searchMaximumMatchCharacters": 4096,
    "terminalMaximumOutputBytes": 65536,
    "terminalDefaultTimeoutMilliseconds": 120000,
    "webAllowedProtocols": ["http:", "https:"],
    "webMaximumResponseBytes": 131072,
    "knowledgeSearchDefaultLimit": 8,
    "knowledgeSearchMaximumLimit": 50,
    "knowledgeListDefaultLimit": 50,
    "knowledgeListMaximumLimit": 500,
    "explicitlyDeniedToolIds": [],
    "projectDeniedToolIds": []
  },
  "context": {
    "checkpointDirectoryName": "context-checkpoints",
    "artifactDirectoryName": "context-artifacts",
    "charactersPerToken": 2,
    "maxTokens": 262144,
    "compressionThresholdRatio": 0.75,
    "recentWindowTokens": 65536,
    "maximumSummaryTokens": 8192,
    "toolInlineTokenLimit": 8192,
    "artifactPreviewCharacters": 1024,
    "maximumPromptBundleBytes": 1048576
  }
}
