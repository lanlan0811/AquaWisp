{
  "schemaVersion": 1,
  "window": {
    "width": 1280,
    "height": 820,
    "minWidth": 960,
    "minHeight": 640,
    "backgroundColor": "#ffffff"
  },
  "runtime": {
    "workingDirectoryName": "runtime",
    "requestTimeoutMs": 10000,
    "runRequestTimeoutMs": 600000,
    "maxLineBytes": 4194304,
    "maxStderrBytes": 65536,
    "runAsNodeEnvironmentVariable": "ELECTRON_RUN_AS_NODE",
    "inheritedEnvironment": ["PATH", "Path", "SystemRoot", "TMP", "TEMP", "LANG", "LC_ALL"]
  },
  "secrets": {
    "fileName": "secrets.json",
    "maxSecretCharacters": 16384,
    "maxCiphertextBytes": 65536
  },
  "knowledge": {
    "maximumFilesPerImport": 32,
    "maximumFailureMessageCharacters": 4096
  },
  "browser": {
    "initialBackendGeneration": 1,
    "requestTimeoutMs": 120000,
    "tabAttachmentTimeoutMs": 10000,
    "maximumTabs": 8,
    "downloadDirectoryName": "downloads",
    "recordingUnavailableMessage": "当前浏览器录屏宿主尚未就绪"
  },
  "executionModes": [
    {
      "id": "plan",
      "label": "计划",
      "description": "只读分析与检索，不写入文件或执行命令",
      "canBeDefault": true,
      "requiresConfirmation": false
    },
    {
      "id": "work",
      "label": "工作",
      "description": "允许工作区内写入与受控命令，边界动作仍需确认",
      "canBeDefault": true,
      "requiresConfirmation": false
    },
    {
      "id": "full_access",
      "label": "完全访问",
      "description": "本会话放宽高风险动作限制，仍保留完整审计记录",
      "canBeDefault": false,
      "requiresConfirmation": true
    }
  ],
  "actionLedger": {
    "maximumDetailCharacters": 4096,
    "summaryFields": ["path", "url", "query", "pattern", "executable", "documentId"],
    "states": [
      { "id": "planned", "label": "已计划" },
      { "id": "authorized", "label": "已授权" },
      { "id": "dispatched", "label": "已派发" },
      { "id": "observed", "label": "已观察" },
      { "id": "verified", "label": "已验证" },
      { "id": "unknown", "label": "待对账" },
      { "id": "denied", "label": "已拒绝" }
    ],
    "toolIcons": [
      { "toolName": "filesystem.read", "icon": "file" },
      { "toolName": "filesystem.glob", "icon": "search" },
      { "toolName": "filesystem.grep", "icon": "search" },
      { "toolName": "filesystem.write", "icon": "write" },
      { "toolName": "filesystem.edit", "icon": "write" },
      { "toolName": "terminal.execute", "icon": "terminal" },
      { "toolName": "web.fetch", "icon": "browser" },
      { "toolName": "browser.observe", "icon": "browser" },
      { "toolName": "browser.command", "icon": "browser" },
      { "toolName": "kb.add", "icon": "write" },
      { "toolName": "kb.search", "icon": "search" },
      { "toolName": "kb.list", "icon": "search" },
      { "toolName": "kb.status", "icon": "search" }
    ]
  },
  "settings": {
    "fileName": "settings.json",
    "defaultProviderId": "bigmodel",
    "defaultModelId": "glm-5.3",
    "defaultProtocol": "chat_completions",
    "defaultReasoningLevel": "max",
    "defaultSecretName": "provider-bigmodel-api-key",
    "defaultMode": "work"
  },
  "ipcChannels": {
    "runtimePing": "aquawisp:runtime:ping",
    "secretSet": "aquawisp:secret:set",
    "secretHas": "aquawisp:secret:has",
    "secretDelete": "aquawisp:secret:delete",
    "settingsGet": "aquawisp:settings:get",
    "settingsSet": "aquawisp:settings:set",
    "conversationStart": "aquawisp:conversation:start",
    "conversationCancel": "aquawisp:conversation:cancel",
    "conversationEvent": "aquawisp:conversation:event",
    "knowledgeList": "aquawisp:knowledge:list",
    "knowledgeAddFiles": "aquawisp:knowledge:add-files",
    "knowledgeRemove": "aquawisp:knowledge:remove",
    "approvalResolve": "aquawisp:approval:resolve",
    "browserExecute": "aquawisp:browser:execute",
    "browserCancel": "aquawisp:browser:cancel",
    "browserState": "aquawisp:browser:state",
    "browserStateChanged": "aquawisp:browser:state-changed",
    "browserCreateTab": "aquawisp:browser:create-tab",
    "browserTabRegistered": "aquawisp:browser:tab-registered",
    "browserActivateTab": "aquawisp:browser:activate-tab"
  }
}
