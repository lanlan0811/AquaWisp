{
  "schemaVersion": 1,
  "window": {
    "width": 1280,
    "height": 820,
    "minWidth": 960,
    "minHeight": 640,
    "backgroundColor": "#ffffff"
  },
  "runtime": {
    "workingDirectoryName": "runtime",
    "requestTimeoutMs": 10000,
    "runRequestTimeoutMs": 600000,
    "maxLineBytes": 4194304,
    "maxStderrBytes": 65536,
    "runAsNodeEnvironmentVariable": "ELECTRON_RUN_AS_NODE",
    "inheritedEnvironment": ["PATH", "Path", "SystemRoot", "TMP", "TEMP", "LANG", "LC_ALL"]
  },
  "secrets": {
    "fileName": "secrets.json",
    "maxSecretCharacters": 16384,
    "maxCiphertextBytes": 65536
  },
  "knowledge": {
    "maximumFilesPerImport": 32,
    "maximumFailureMessageCharacters": 4096
  },
  "settings": {
    "fileName": "settings.json",
    "defaultProviderId": "bigmodel",
    "defaultModelId": "glm-5.3",
    "defaultProtocol": "chat_completions",
    "defaultReasoningLevel": "max",
    "defaultSecretName": "provider-bigmodel-api-key",
    "defaultMode": "work"
  },
  "ipcChannels": {
    "runtimePing": "aquawisp:runtime:ping",
    "secretSet": "aquawisp:secret:set",
    "secretHas": "aquawisp:secret:has",
    "secretDelete": "aquawisp:secret:delete",
    "settingsGet": "aquawisp:settings:get",
    "settingsSet": "aquawisp:settings:set",
    "conversationStart": "aquawisp:conversation:start",
    "conversationCancel": "aquawisp:conversation:cancel",
    "conversationEvent": "aquawisp:conversation:event",
    "knowledgeList": "aquawisp:knowledge:list",
    "knowledgeAddFiles": "aquawisp:knowledge:add-files",
    "knowledgeRemove": "aquawisp:knowledge:remove",
    "approvalResolve": "aquawisp:approval:resolve"
  }
}
